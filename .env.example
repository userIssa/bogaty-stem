# SMTP credentials for the contact form (app/api/contact/route.ts)
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to git.

# Examples:
# Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  SMTP_SECURE=true  (use an App Password, not your normal password)
# Outlook:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
# cPanel/Custom domain: ask your hosting provider for the SMTP host/port
#yowa

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=

# NextAuth.js configuration (for portal authentication)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# MongoDB configuration
MONGODB_URI=
MONGODB_DB=